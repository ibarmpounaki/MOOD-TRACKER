<!-- Left big box -->
<section class="part menu-bar">
  <div class="categories-top">
    <div class="menu user-info">
      <div class="rounded-profile-pic">
        <span class="firstUsrLetter"
          ><%=userName.slice(0,1).toUpperCase()%></span
        >
      </div>
      <div class="user-name"><%=userName%></div>
      <div class="UserStreakDays">
        <%= streak > 0 ? streak + ' day streak!' : '' %>
      </div>
    </div>
    <div class="leftMenu-divider"></div>
    <div class="menu categories first-cat active">
      <a class="journal" href="/dashboard">
        <i class="ti ti-notebook menu-image" aria-hidden="true"></i>
        Journal
      </a>
    </div>
    <div class="menu categories">
      <a class="statistics" href="/statistics">
        <i class="ti ti-chart-bar menu-image" aria-hidden="true"></i>
        Statistics
      </a>
    </div>
  </div>
  <div class="categories-bottom">
    <div class="leftMenu-divider"></div>
    <div class="menu categories">
      <a class="settings disabled" aria-disabled="true">
        <i class="ti ti-settings menu-image" aria-hidden="true"></i>
        Settings
      </a>
    </div>
    <form class="menu categories" action="/logout" method="POST">
      <button class="logout" type="submit">
        <i class="ti ti-logout menu-image" aria-hidden="true"></i>
        Logout
      </button>
    </form>
  </div>
</section>
